# Copy to .env for local development. Do not commit the filled-in .env.
# On Render, leave PORT unset - the platform injects it.
PORT=5000

# BASE_URL must match where the customer's browser can actually reach this server.
# Local: http://localhost:5000    Render: https://<service>.onrender.com
# No trailing slash - the success/cancel paths are appended directly.
BASE_URL=http://localhost:5000

STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Optional. Without it /api/stripe/webhook stays disabled (see server.js).
STRIPE_WEBHOOK_SECRET=whsec_xxx

BC_COMPANY=
BC_ENVIRONMENT=Sandbox
TENANT_ID=

# Template only - every value here is a dummy. Copy to .env and fill in the real
# ones. Never put a real key in this file: .env is gitignored, this file is not.
# On Render, leave PORT unset - the platform injects it.
PORT=5000

# Where the customer's browser can actually reach this server. Local only.
# On Render leave this blank - server.js falls back to the injected
# RENDER_EXTERNAL_URL, so the real origin is filled in automatically.
# No trailing slash - the success/cancel paths are appended directly.
BASE_URL=http://localhost:5000

STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Optional. Without it /api/stripe/webhook stays disabled (see server.js).
STRIPE_WEBHOOK_SECRET=whsec_xxx

BC_COMPANY=
BC_ENVIRONMENT=Sandbox
TENANT_ID=
